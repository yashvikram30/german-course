# Put these in .env (git-ignored) and restart `npm run dev`.
TOKEN_API_KEY=
# Optional. Defaults: https://tokenharbor.ai/v1 and the free DeepSeek model.
# TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
# TOKENHARBOR_MODEL=deepseek-v4-flash:free

# MongoDB connection string for your progress (required). Optional MONGO_DB sets the database name (default: german).
MONGO_URI=

# Random string (16+ characters) that signs login cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=
